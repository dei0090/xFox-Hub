-- TOGGLE
--==================================================

local function Toggle(Page, Text, Default)

    local B = Instance.new("TextButton")
    B.Parent = Page
    B.Size = UDim2.new(1,0,0,62)
    B.BackgroundColor3 = CardColor
    B.Text = ""
    B.BorderSizePixel = 0
    B.AutoButtonColor = false

    Corner(B,10)
    Stroke(B)

    local Label = Instance.new("TextLabel")
    Label.Parent = B
    Label.Position = UDim2.fromOffset(17,0)
    Label.Size = UDim2.new(1,-105,1,0)
    Label.BackgroundTransparency = 1
    Label.Text = Text
    Label.TextColor3 = TextColor
    Label.TextSize = 14
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local State = Instance.new("TextLabel")
    State.Parent = B
    State.AnchorPoint = Vector2.new(1,0.5)
    State.Position = UDim2.new(1,-12,0.5,0)
    State.Size = UDim2.fromOffset(58,38)
    State.BorderSizePixel = 0
    State.TextSize = 12
    State.Font = Enum.Font.GothamBold

    Corner(State,8)

    local Enabled = Default

    local function Update()

        State.Text = Enabled and "ON" or "OFF"

        State.BackgroundColor3 =
            Enabled
            and Theme
            or Color3.fromRGB(55,55,60)

        State.TextColor3 =
            Color3.fromRGB(255,255,255)

    end

    B.Activated:Connect(function()

        Enabled = not Enabled

        Update()

    end)

    Update()

    return B
end

