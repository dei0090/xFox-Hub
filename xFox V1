-- SLIDER / AJUSTE
--==================================================

local function Slider(Page, Text, Default, Step, Min, Max)

    local Holder = Instance.new("Frame")
    Holder.Parent = Page
    Holder.Size = UDim2.new(1,0,0,78)
    Holder.BackgroundColor3 = CardColor
    Holder.BorderSizePixel = 0

    Corner(Holder,10)
    Stroke(Holder)

    local Label = Instance.new("TextLabel")
    Label.Parent = Holder
    Label.Position = UDim2.fromOffset(17,7)
    Label.Size = UDim2.new(1,-34,0,25)
    Label.BackgroundTransparency = 1
    Label.Text = Text
    Label.TextColor3 = TextColor
    Label.TextSize = 14
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local Minus = Instance.new("TextButton")
    Minus.Parent = Holder
    Minus.Position = UDim2.fromOffset(12,40)
    Minus.Size = UDim2.fromOffset(45,30)
    Minus.BackgroundColor3 = Color3.fromRGB(45,45,51)
    Minus.Text = "−"
    Minus.TextColor3 = TextColor
    Minus.TextSize = 18
    Minus.Font = Enum.Font.GothamBold
    Minus.BorderSizePixel = 0

    Corner(Minus,7)

    local Plus = Instance.new("TextButton")
    Plus.Parent = Holder
    Plus.AnchorPoint = Vector2.new(1,0)
    Plus.Position = UDim2.new(1,-12,0,40)
    Plus.Size = UDim2.fromOffset(45,30)
    Plus.BackgroundColor3 = Color3.fromRGB(45,45,51)
    Plus.Text = "+"
    Plus.TextColor3 = TextColor
    Plus.TextSize = 18
    Plus.Font = Enum.Font.GothamBold
    Plus.BorderSizePixel = 0

    Corner(Plus,7)

    local Value = Instance.new("TextLabel")
    Value.Parent = Holder
    Value.AnchorPoint = Vector2.new(0.5,0)
    Value.Position = UDim2.new(0.5,0,0,40)
    Value.Size = UDim2.fromOffset(90,30)
    Value.BackgroundTransparency = 1
    Value.TextColor3 = TextColor
    Value.TextSize = 13
    Value.Font = Enum.Font.GothamBold

    local Number = Default

    local function Update()

        Number = math.clamp(Number,Min,Max)

        Value.Text = string.format("%.2f",Number)

    end

    Minus.Activated:Connect(function()

        Number -= Step
        Update()

    end)

    Plus.Activated:Connect(function()

        Number += Step
        Update()

    end)

    Update()

    return Holder
end

