-- Responsive sidebar
local function responsive()
    local width = main.AbsoluteSize.X

    if width < 600 then
        sidebar.Size = UDim2.new(0, 140, 1, -64)
        content.Position = UDim2.new(0, 140, 0, 64)
        content.Size = UDim2.new(1, -140, 1, -64)
        title.TextSize = 18
    else
        sidebar.Size = UDim2.new(0, 185, 1, -64)
        content.Position = UDim2.new(0, 185, 0, 64)
        content.Size = UDim2.new(1, -185, 1, -64)
        title.TextSize = 22
    end
end

main:GetPropertyChangedSignal("AbsoluteSize"):Connect(responsive)
responsive()

