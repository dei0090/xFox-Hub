-- Navigation
local function showPage(page, pageTitle)
    for _, p in pairs(pages) do
        p.Visible = false
    end
    page.Visible = true
    contentTitle.Text = "|  " .. pageTitle

    if currentButton then
        currentButton.BackgroundColor3 = PANEL
        currentButton.TextColor3 = MUTED
    end
end

local function navButton(text, page, pageTitle)
    local b = Instance.new("TextButton")
    b.Parent = side
    b.Size = UDim2.new(1, 0, 0, 40)
    b.BackgroundColor3 = PANEL
    b.Text = "   " .. text
    b.TextColor3 = MUTED
    b.TextSize = 13
    b.Font = Enum.Font.GothamMedium
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    corner(b, 7)

    b.Activated:Connect(function()
        showPage(page, pageTitle)
        b.BackgroundColor3 = Color3.fromRGB(38, 38, 43)
        b.TextColor3 = ORANGE
        currentButton = b
    end)

    return b
end

