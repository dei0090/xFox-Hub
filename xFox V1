local function MobileAdjust()

    local Width =
        Main.AbsoluteSize.X

    if Width < 600 then

        for _,Object in ipairs(
            Content:GetDescendants()
        ) do

            if Object:IsA("TextLabel")
                or Object:IsA("TextButton")
                or Object:IsA("TextBox") then

                if Object.TextSize > 16 then
                    Object.TextSize = 15
                end

            end

        end

    end
end

