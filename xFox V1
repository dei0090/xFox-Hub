local function ShowPage(Page, Title)

    for _,P in pairs(Pages) do
        P.Visible = false
    end

    Page.Visible = true
    ContentTitle.Text = "│  "..Title

    if CurrentButton then

        CurrentButton.BackgroundColor3 =
            SidebarColor

        CurrentButton.TextColor3 =
            MutedColor

    end
end

local function NavigationButton(Text, Page, Title)

    local B = SideButton(Text)

    B.Activated:Connect(function()

        ShowPage(Page,Title)

        B.BackgroundColor3 =
            Color3.fromRGB(38,38,43)

        B.TextColor3 =
            Theme

        CurrentButton = B

    end)

    return B
end

