local function toggle(page, text, default, settingName)
    local b = Instance.new("TextButton")
    b.Parent = page
    b.Size = UDim2.new(1, 0, 0, 56)
    b.BackgroundColor3 = CARD
    b.BorderSizePixel = 0
    b.Text = ""
    b.AutoButtonColor = false
    corner(b, 9)
    stroke(b)

    local label = Instance.new("TextLabel")
    label.Parent = b
    label.Position = UDim2.new(0, 14, 0, 0)
    label.Size = UDim2.new(1, -105, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = TEXT
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left

    local state = Instance.new("TextLabel")
    state.Parent = b
    state.AnchorPoint = Vector2.new(1, 0.5)
    state.Position = UDim2.new(1, -10, 0.5, 0)
    state.Size = UDim2.new(0, 58, 0, 34)
    state.BorderSizePixel = 0
    state.TextColor3 = TEXT
    state.TextSize = 12
    state.Font = Enum.Font.GothamBold
    corner(state, 7)

    local enabled = default == true

    local function update()
        state.Text = enabled and "ON" or "OFF"
        state.BackgroundColor3 = enabled and ORANGE or Color3.fromRGB(55, 55, 60)
        if settingName then
            Settings[settingName] = enabled
        end
    end

    b.Activated:Connect(function()
        enabled = not enabled
        update()
    end)

    update()
    return b
end

local function select(page, text, values, default, settingName)
    local b = Instance.new("TextButton")
    b.Parent = page
    b.Size = UDim2.new(1, 0, 0, 56)
    b.BackgroundColor3 = CARD
    b.BorderSizePixel = 0
    b.Text = ""
    b.AutoButtonColor = false
    corner(b, 9)
    stroke(b)

    local label = Instance.new("TextLabel")
    label.Parent = b
    label.Position = UDim2.new(0, 14, 0, 0)
    label.Size = UDim2.new(1, -125, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = TEXT
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left

    local value = Instance.new("TextLabel")
    value.Parent = b
    value.AnchorPoint = Vector2.new(1, 0.5)
    value.Position = UDim2.new(1, -10, 0.5, 0)
    value.Size = UDim2.new(0, 105, 0, 34)
    value.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    value.TextColor3 = TEXT
    value.TextSize = 12
    value.Font = Enum.Font.GothamBold
    value.BorderSizePixel = 0
    corner(value, 7)

    local index = default or 1

    local function update()
        value.Text = tostring(values[index])
        if settingName then
            Settings[settingName] = values[index]
        end
    end

    b.Activated:Connect(function()
        index = index + 1
        if index > #values then
            index = 1
        end
        update()
    end)

    update()
    return b
end

local function slider(page, text, default, step, min, max, settingName)
    local holder = Instance.new("Frame")
    holder.Parent = page
    holder.Size = UDim2.new(1, 0, 0, 72)
    holder.BackgroundColor3 = CARD
    holder.BorderSizePixel = 0
    corner(holder, 9)
    stroke(holder)

    local label = Instance.new("TextLabel")
    label.Parent = holder
    label.Position = UDim2.new(0, 14, 0, 6)
    label.Size = UDim2.new(1, -28, 0, 24)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = TEXT
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left

    local minus = Instance.new("TextButton")
    minus.Parent = holder
    minus.Position = UDim2.new(0, 10, 0, 38)
    minus.Size = UDim2.new(0, 42, 0, 26)
    minus.BackgroundColor3 = Color3.fromRGB(45, 45, 51)
    minus.Text = "-"
    minus.TextColor3 = TEXT
    minus.TextSize = 16
    minus.Font = Enum.Font.GothamBold
    minus.BorderSizePixel = 0
    corner(minus, 6)

    local plus = Instance.new("TextButton")
    plus.Parent = holder
    plus.AnchorPoint = Vector2.new(1, 0)
    plus.Position = UDim2.new(1, -10, 0, 38)
    plus.Size = UDim2.new(0, 42, 0, 26)
    plus.BackgroundColor3 = Color3.fromRGB(45, 45, 51)
    plus.Text = "+"
    plus.TextColor3 = TEXT
    plus.TextSize = 16
    plus.Font = Enum.Font.GothamBold
    plus.BorderSizePixel = 0
    corner(plus, 6)

    local value = Instance.new("TextLabel")
    value.Parent = holder
    value.AnchorPoint = Vector2.new(0.5, 0)
    value.Position = UDim2.new(0.5, 0, 0, 38)
    value.Size = UDim2.new(0, 90, 0, 26)
    value.BackgroundTransparency = 1
    value.TextColor3 = TEXT
    value.TextSize = 13
    value.Font = Enum.Font.GothamBold

    local number = default

    local function update()
        number = math.clamp(number, min, max)
        value.Text = string.format("%.2f", number)
        if settingName then
            Settings[settingName] = number
        end
    end

    minus.Activated:Connect(function()
        number = number - step
        update()
    end)

    plus.Activated:Connect(function()
        number = number + step
        update()
    end)

    update()
    return holder
end

