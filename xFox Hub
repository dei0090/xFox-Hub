--==================================================

local function RefreshLists()

	for _,Child in ipairs(
		Scroll:GetChildren()
	) do

		if Child:GetAttribute(
			"FoxListEntry"
		) then

			Child:Destroy()

		end

	end

	WhiteHeader.LayoutOrder = 100
	BlackHeader.LayoutOrder = 200

	for UserId in pairs(
		Whitelist
	) do

		local Player =
			Players:GetPlayerByUserId(
				UserId
			)

		if Player then

			local B =
				Button(
					"✓ "
					..Player.Name
					.."     ×"
				)

			B:SetAttribute(
				"FoxListEntry",
				true
			)

			B.LayoutOrder = 110

			B.BackgroundColor3 =
				Color3.fromRGB(
					40,110,70
				)

			B.Activated:Connect(function()

				Whitelist[UserId] =
					nil

				Status.Text =
					Player.Name
					.." eliminado de WHITELIST."

				RefreshLists()

			end)

		end

	end

	for UserId in pairs(
		Blacklist
	) do

		local Player =
			Players:GetPlayerByUserId(
				UserId
			)

		if Player then

			local B =
				Button(
					"✕ "
					..Player.Name
					.."     ×"
				)

			B:SetAttribute(
				"FoxListEntry",
				true
			)

			B.LayoutOrder = 210

			B.BackgroundColor3 =
				Color3.fromRGB(
					100,40,40
				)

			B.Activated:Connect(function()

				Blacklist[UserId] =
					nil

				Status.Text =
					Player.Name
					.." eliminado de BLACKLIST."

				RefreshLists()

			end)

		end

	end
end

