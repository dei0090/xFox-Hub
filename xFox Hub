		UDim2.fromOffset(10,38)

	Minus.Text = "−"
	Minus.TextSize = 20
	Minus.TextColor3 =
		Color3.new(1,1,1)

	Minus.BackgroundColor3 =
		Color3.fromRGB(48,48,55)

	Minus.Parent = Holder

	AddCorner(Minus,7)

	local Plus =
		Instance.new("TextButton")

	Plus.Size =
		UDim2.fromOffset(65,32)

	Plus.Position =
		UDim2.new(1,-75,0,38)

	Plus.Text = "+"
	Plus.TextSize = 20
	Plus.TextColor3 =
		Color3.new(1,1,1)

	Plus.BackgroundColor3 =
		Color3.fromRGB(48,48,55)

	Plus.Parent = Holder

	AddCorner(Plus,7)

	local function Update()

		Label.Text =
			LabelText
			..Format(Value)

	end

	Minus.Activated:Connect(function()

		Value =
			math.clamp(
				Value - Step,
				Min,
				Max
			)

		Update()
	end)

	Plus.Activated:Connect(function()

		Value =
			math.clamp(
				Value + Step,
				Min,
				Max
			)

		Update()
	end)

	Update()
end

