local function Normalize(Text)

	return string.lower(
		string.gsub(
			Text,
			"%s+",
			""
		)
	)

end

local function UpdateSuggestions()

	-- Limpiar sugerencias anteriores
	for _,Child in ipairs(
		SuggestionsFrame:GetChildren()
	) do

		if Child:IsA("TextButton") then
			Child:Destroy()
		end

	end

	local Search =
		Normalize(NameBox.Text)

	if Search == "" then

		SuggestionsFrame.Visible = false
		SuggestionsFrame.Size =
			UDim2.new(1,0,0,0)

		return
	end

	local Found = {}

	for _,Player in ipairs(
		Players:GetPlayers()
	) do

		if Player ~= LocalPlayer then

			local Name =
				Normalize(Player.Name)

			local Display =
				Normalize(Player.DisplayName)

			if string.find(Name,Search,1,true)
				or string.find(Display,Search,1,true) then

				table.insert(
					Found,
					Player
				)

			end
		end
	end

	-- Máximo 5 sugerencias
	local MaxSuggestions =
		math.min(#Found,5)

	if MaxSuggestions == 0 then

		SuggestionsFrame.Visible = false
		SuggestionsFrame.Size =
			UDim2.new(1,0,0,0)

		return
	end

	for Index = 1,MaxSuggestions do

		local Player =
			Found[Index]

		local Suggestion =
			Instance.new("TextButton")

		Suggestion.Size =
			UDim2.new(1,0,0,38)

		Suggestion.BackgroundColor3 =
			Color3.fromRGB(45,45,52)

		Suggestion.Text =
			"👤 "
			..Player.DisplayName
			.."  (@"
			..Player.Name
			..")"

		Suggestion.TextColor3 =
			Color3.new(1,1,1)

		Suggestion.TextSize = 13

		Suggestion.Font =
			Enum.Font.Gotham

		Suggestion.AutoButtonColor = true
		Suggestion.Parent =
			SuggestionsFrame

		AddCorner(Suggestion,7)

		Suggestion.Activated:Connect(function()

			NameBox.Text =
				Player.Name

			NameBox.CursorPosition =
				#NameBox.Text + 1

			SuggestionsFrame.Visible =
				false

			SuggestionsFrame.Size =
				UDim2.new(1,0,0,0)

		end)

	end

	SuggestionsFrame.Visible = true

	SuggestionsFrame.Size =
		UDim2.new(
			1,
			0,
			0,
			(MaxSuggestions * 42) + 4
		)

end

NameBox:GetPropertyChangedSignal("Text"):Connect(
	UpdateSuggestions
)

