--==================================================
-- 🔎 FIND PLAYER
--==================================================

local function FindPlayer(Text)

	Text =
		Normalize(Text)

	if Text == "" then
		return nil
	end

	for _,Player in ipairs(
		Players:GetPlayers()
	) do

		local Name =
			Normalize(Player.Name)

		local Display =
			Normalize(Player.DisplayName)

		if Name == Text
			or Display == Text then

			return Player
		end

	end

	return nil
end

