--==================================================
-- 🎯 AIM TARGET
--==================================================

local function IsTargetAllowed(Player)

	if Player == LocalPlayer then
		return false
	end

	if Whitelist[Player.UserId] then
		return false
	end

	if Blacklist[Player.UserId] then
		return false
	end

	if Settings.TargetTeam == "Todos" then
		return true
	end

	if not Player.Team then
		return false
	end

	local TeamName = string.lower(Player.Team.Name)

	return TeamName ==
		string.lower(Settings.TargetTeam)
end

local function GetClosestTarget()

	local Character = LocalPlayer.Character

	if not Character then
		return nil
	end

	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return nil
	end

	local Closest = nil
	local ClosestDistance = math.huge

	for _,Player in ipairs(Players:GetPlayers()) do

		if IsTargetAllowed(Player) then

			local TargetCharacter =
				Player.Character

			local Head =
				TargetCharacter
				and TargetCharacter:FindFirstChild("Head")

			local Humanoid =
				TargetCharacter
				and TargetCharacter:FindFirstChildOfClass(
					"Humanoid"
				)

			if Head
				and Humanoid
				and Humanoid.Health > 0 then

				local Distance =
					(Root.Position - Head.Position).Magnitude

				if Distance < ClosestDistance then
					ClosestDistance = Distance
					Closest = Player
				end
			end
		end
	end

	return Closest
end

--==================================================
-- AIM CAMERA
--==================================================

RunService.RenderStepped:Connect(function()

	if not Settings.AimEnabled then
		return
	end

	local Target = GetClosestTarget()

	if not Target then
		return
	end

	local Character =
		Target.Character

	if not Character then
		return
	end

	local Head =
		Character:FindFirstChild("Head")

	if not Head then
		return
	end

	local TargetPosition = Head.Position

	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	if Root then
		TargetPosition =
			TargetPosition
			+ Root.AssemblyLinearVelocity
			* Settings.Prediction
	end

	local Current =
		Camera.CFrame

	local Desired =
		CFrame.lookAt(
			Current.Position,
			TargetPosition
		)

	Camera.CFrame =
		Current:Lerp(
			Desired,
			math.clamp(
				Settings.Smoothness,
				0.01,
				1
			)
		)
end)

