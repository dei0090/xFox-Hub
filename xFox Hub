local function GetTeamName(Player)

	if Player.Team then
		return Player.Team.Name
	end

	local Attribute =
		Player:GetAttribute("Team")

	if Attribute then
		return tostring(Attribute)
	end

	return "Sin equipo"
end

--==================================================
-- ESP CREATION
--==================================================

local function CreateESP(Player)

	if Player == LocalPlayer then
		return
	end

	local function CharacterAdded(Character)

		local Old =
			Character:FindFirstChild("xFoxESP")

		if Old then
			Old:Destroy()
		end

		local Billboard =
			Instance.new("BillboardGui")

		Billboard.Name = "xFoxESP"
		Billboard.Size = UDim2.fromOffset(190,75)
		Billboard.StudsOffset =
			Vector3.new(0,3,0)
		Billboard.AlwaysOnTop = true
		Billboard.Enabled = Settings.ESP
		Billboard.Parent = Character

		local Text =
			Instance.new("TextLabel")

		Text.Name = "Info"
		Text.Size = UDim2.fromScale(1,1)
		Text.BackgroundTransparency = 1
		Text.TextColor3 = Color3.new(1,1,1)
		Text.TextStrokeTransparency = 0.2
		Text.TextSize = 13
		Text.Font = Enum.Font.GothamBold
		Text.TextWrapped = true
		Text.Parent = Billboard
	end

	if Player.Character then
		CharacterAdded(Player.Character)
	end

	Player.CharacterAdded:Connect(CharacterAdded)
end

for _,Player in ipairs(Players:GetPlayers()) do
	CreateESP(Player)
end

Players.PlayerAdded:Connect(CreateESP)

--==================================================
-- ESP UPDATE
--==================================================

RunService.RenderStepped:Connect(function()

	for _,Player in ipairs(Players:GetPlayers()) do

		if Player ~= LocalPlayer
			and Player.Character then

			local Character =
				Player.Character

			local Root =
				Character:FindFirstChild(
					"HumanoidRootPart"
				)

			local Billboard =
				Character:FindFirstChild(
					"xFoxESP"
				)

			if Billboard then

				Billboard.Enabled =
					Settings.ESP

				local Text =
					Billboard:FindFirstChild(
						"Info"
					)

				if Text then

					local Info = {}

					if Settings.ShowName then
						table.insert(
							Info,
							Player.DisplayName
						)
					end

					if Settings.ShowTeam then
						table.insert(
							Info,
							"Team: "
								.. GetTeamName(Player)
						)
					end

					if Settings.ShowDistance
						and Root then

						local MyCharacter =
							LocalPlayer.Character

						local MyRoot =
							MyCharacter
							and MyCharacter:FindFirstChild(
								"HumanoidRootPart"
							)

						if MyRoot then

							local Distance =
								math.floor(
									(
										MyRoot.Position
										- Root.Position
									).Magnitude
								)

							table.insert(
								Info,
								Distance
								.. " studs"
							)
						end
					end

					Text.Text =
						table.concat(
							Info,
							"\n"
						)
				end
			end
		end
	end
end)

