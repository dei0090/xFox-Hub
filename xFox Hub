local function Slider(LabelText, Value, Step, Min, Max, Format)

	local Holder = Instance.new("Frame")
	Holder.Size = UDim2.new(1,0,0,75)
	Holder.BackgroundColor3 = Color3.fromRGB(35,35,41)
	Holder.Parent = Scroll

	AddCorner(Holder,9)

